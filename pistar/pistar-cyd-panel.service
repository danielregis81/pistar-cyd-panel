[Unit]
Description=pistar-cyd-panel (dados do "quem esta falando" para o painel CYD)
After=network.target nginx.service

[Service]
Type=simple
User=mmdvm
Group=mmdvm
# /run/pistar-cyd-panel em memoria (tmpfs): nao grava no cartao SD
RuntimeDirectory=pistar-cyd-panel
RuntimeDirectoryMode=0755
# garante o link /var/www/dashboard/cyd -> /run/pistar-cyd-panel (roda como root)
ExecStartPre=+/usr/local/lib/pistar-cyd-panel/ensure-link.sh
ExecStart=/usr/bin/python3 /usr/local/lib/pistar-cyd-panel/pistar-cyd-panel.py
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
